syntax = "v1"

type (
	ListAuditLogsRequest {
		Page     int64  `form:"page,default=1,range=[1:10000]"`
		PageSize int64  `form:"pageSize,default=20,range=[1:100]"`
		Keyword  string `form:"keyword,optional"`
		Action   string `form:"action,optional"`
		ActorId  string `form:"actorId,optional"`
		TraceId  string `form:"traceId,optional"`
		From     string `form:"from,optional"` // Inclusive RFC3339 timestamp; defaults to 90 days before to.
		To       string `form:"to,optional"` // Exclusive RFC3339 timestamp; defaults to now. Maximum window: 366 days.
	}
	GetAuditLogRequest {
		Id string `path:"id"`
	}
	AuditAction {
		Code string `json:"code"`
		Name string `json:"name"`
	}
	AuditLogRecord {
		Id           string `json:"id"`
		Action       string `json:"action"`
		ActionName   string `json:"actionName"`
		ActorId      string `json:"actorId"`
		ActorUsername string `json:"actorUsername"`
		ActorName    string `json:"actorName"`
		Source       string `json:"source"`
		TargetType   string `json:"targetType"`
		TargetId     string `json:"targetId"`
		TargetKey    string `json:"targetKey"`
		TargetName   string `json:"targetName"`
		TraceId      string `json:"traceId"`
		CreatedAt    string `json:"createdAt"`
	}
	AuditChange {
		Field  string   `json:"field"`
		Label  string   `json:"label"`
		Before []string `json:"before"`
		After  []string `json:"after"`
	}
	AuditLogListData {
		Items    []AuditLogRecord `json:"items"`
		Actions  []AuditAction    `json:"actions"`
		Total    int64            `json:"total"`
		Page     int64            `json:"page"`
		PageSize int64            `json:"pageSize"`
	}
	AuditLogListResponse {
		Code    int              `json:"code"`
		Message string           `json:"message"`
		Data    AuditLogListData `json:"data"`
		TraceId string           `json:"traceId"`
	}
	AuditLogDetailData {
		Record  AuditLogRecord `json:"record"`
		Changes []AuditChange  `json:"changes"`
	}
	AuditLogDetailResponse {
		Code    int                `json:"code"`
		Message string             `json:"message"`
		Data    AuditLogDetailData `json:"data"`
		TraceId string             `json:"traceId"`
	}
)

@server (
	prefix:     /admin-api/v1/system
	group:      audit
	middleware: AdminAccess
	tags:       "Operation audit"
)
service admin-api {
	@doc "Audit search; page offset must be below 10000 and time window at most 366 days"
	@handler ListAuditLogs
	get /audit-logs (ListAuditLogsRequest) returns (AuditLogListResponse)

	@handler GetAuditLog
	get /audit-logs/:id (GetAuditLogRequest) returns (AuditLogDetailResponse)
}
