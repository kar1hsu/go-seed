# Local development only. Copy to .env; never use these credentials in production.
# Shared IANA timezone for every service, container and file date directory.
TZ=Asia/Shanghai
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=goseed_system
MYSQL_USER=goseed
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
SYSTEM_RPC_HOST=127.0.0.1
SYSTEM_RPC_PORT=19001
API_HOST=127.0.0.1
ADMIN_API_PORT=8081
APP_API_PORT=8080
WEB_PORT=5173
GATEWAY_PORT=8088

# Run make init to generate private local keys and the initial administrator password.
# Ed25519 keys and independent refresh key use unpadded base64url. Generated by make init.
ADMIN_TOKEN_PUBLIC_KEY=
ADMIN_TOKEN_PRIVATE_KEY=
ADMIN_REFRESH_KEY=
ADMIN_RPC_SECRET=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_COOKIE_SECURE=false
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8088,http://localhost:8088,http://127.0.0.1:8081,http://localhost:8081

# Private files: local shared volume by default; use S3 for separate hosts.
STORAGE_DRIVER=local
STORAGE_ROOT=.data/files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SECURE=true
S3_REGION=us-east-1
# Queue uses a separate Redis DB; production should use a dedicated noeviction instance.
QUEUE_HOST=127.0.0.1
QUEUE_PORT=16379
QUEUE_PASSWORD=
QUEUE_DB=1
QUEUE_NAME=goseed_dev_system
TASK_HOST=127.0.0.1
SYSTEM_WORKER_PORT=19201
SYSTEM_SCHEDULER_PORT=19202

# C-end member domain; separate schema, DB user, signing key and service credentials.
MEMBER_MYSQL_DATABASE=goseed_member
MEMBER_MYSQL_USER=goseed_member
MEMBER_MYSQL_PASSWORD=
MEMBER_RPC_HOST=127.0.0.1
MEMBER_RPC_PORT=19002
# Ed25519 keys and independent refresh key use unpadded base64url. Generated by make init.
MEMBER_TOKEN_PUBLIC_KEY=
MEMBER_TOKEN_PRIVATE_KEY=
MEMBER_REFRESH_KEY=
MEMBER_ADMIN_RPC_SECRET=
MEMBER_APP_RPC_SECRET=
MEMBER_SYSTEM_RPC_SECRET=
MEMBER_COOKIE_SECURE=false
MEMBER_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088,http://127.0.0.1:8080,http://localhost:8080
MEMBER_REGISTER_RATE=10
MEMBER_LOGIN_RATE=120

GOSEED_MODE=dev
# Empty trusts no proxy; Compose supplies only its dedicated gateway address.
TRUSTED_PROXY_CIDRS=

# TLS paths are mounted by the production deployment; pro refuses plaintext RPC.
RPC_TLS_CA=
SYSTEM_RPC_TLS_NAME=
SYSTEM_RPC_TLS_CERT=
SYSTEM_RPC_TLS_KEY=
MEMBER_RPC_TLS_NAME=
MEMBER_RPC_TLS_CERT=
MEMBER_RPC_TLS_KEY=

# 0 keeps all audit history. Set only after choosing a retention/archive policy.
AUDIT_RETENTION_DAYS=0
