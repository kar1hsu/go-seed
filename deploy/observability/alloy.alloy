otelcol.receiver.otlp "goseed" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		traces = [otelcol.processor.filter.probes.input]
	}
}

otelcol.processor.filter "probes" {
	error_mode = "ignore"

	trace_conditions {
		conditions = [
			`span.name == "goseed.system.v1.System/CheckReady"`,
			`span.name == "goseed.member.v1.Member/CheckReady"`,
			`span.name == "grpc.health.v1.Health/Check"`,
		]
	}

	output {
		traces = [otelcol.processor.transform.client_privacy.input]
	}
}

// Enforce the storage boundary for other OTLP producers and rolling upgrades.
otelcol.processor.transform "client_privacy" {
	trace_statements {
		context    = "span"
		statements = [
			`delete_key(attributes, "http.client_ip")`,
			`delete_key(attributes, "http.user_agent")`,
			`delete_key(attributes, "client.address")`,
			`delete_key(attributes, "user_agent.original")`,
			`delete_key(attributes, "net.peer.ip")`,
			`delete_key(attributes, "net.sock.peer.addr")`,
			`delete_key(attributes, "network.peer.address")`,
		]
	}

	output {
		traces = [otelcol.processor.tail_sampling.local.input]
	}
}

otelcol.processor.tail_sampling "local" {
	decision_wait = "5s"

	policy {
		name = "service-failures"
		type = "ottl_condition"

		ottl_condition {
			error_mode = "ignore"
			// Match service faults on individual spans, even when another span
			// in the same trace reports an expected application rejection.
			span = [
				`attributes["http.status_code"] != nil and attributes["http.status_code"] >= 500 and attributes["http.status_code"] < 600`,
				`attributes["rpc.grpc.status_code"] == 2 or attributes["rpc.grpc.status_code"] == 4 or attributes["rpc.grpc.status_code"] == 13 or attributes["rpc.grpc.status_code"] == 14 or attributes["rpc.grpc.status_code"] == 15`,
			]
		}
	}

	policy {
		name = "slow"
		type = "latency"

		latency {
			threshold_ms = 1000
		}
	}

	policy {
		name = "baseline"
		type = "probabilistic"

		probabilistic {
			// Local development retains all other traces. Lower this in production.
			sampling_percentage = coalesce(sys.env("TRACE_BASELINE_PERCENT"), "100")
		}
	}

	output {
		traces = [otelcol.processor.batch.local.input]
	}
}

otelcol.processor.batch "local" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}
